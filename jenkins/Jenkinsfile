pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'dragneel277'

        APP_PORT = '80'

        // IP interno entre VMs: backend -> database
        DB_HOST = '10.0.2.4'

        // IP Host-only: Jenkins/WSL -> app VM
        APP_VM_HOST = '192.168.56.101'

        BACKEND_URL = 'http://192.168.56.101:3000'
        FRONTEND_URL = 'http://192.168.56.101'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build images') {
            steps {
                sh "docker build -t billing-backend:${BUILD_NUMBER} ./backend"
                sh "docker build -t billing-frontend:${BUILD_NUMBER} ./frontend"
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER_CRED',
                    passwordVariable: 'DOCKERHUB_PASS'
                )]) {
                    sh 'echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER_CRED" --password-stdin'

                    sh "docker tag billing-backend:${BUILD_NUMBER} ${DOCKERHUB_USER}/billing-backend:${BUILD_NUMBER}"
                    sh "docker push ${DOCKERHUB_USER}/billing-backend:${BUILD_NUMBER}"
                    sh "docker tag billing-backend:${BUILD_NUMBER} ${DOCKERHUB_USER}/billing-backend:latest"
                    sh "docker push ${DOCKERHUB_USER}/billing-backend:latest"

                    sh "docker tag billing-frontend:${BUILD_NUMBER} ${DOCKERHUB_USER}/billing-frontend:${BUILD_NUMBER}"
                    sh "docker push ${DOCKERHUB_USER}/billing-frontend:${BUILD_NUMBER}"
                    sh "docker tag billing-frontend:${BUILD_NUMBER} ${DOCKERHUB_USER}/billing-frontend:latest"
                    sh "docker push ${DOCKERHUB_USER}/billing-frontend:latest"
                }
            }
        }

        stage('Deploy via Ansible to VMs') {
            steps {
                withCredentials([
                    string(credentialsId: 'db-password', variable: 'DB_PASS'),
                    string(credentialsId: 'jwt-secret', variable: 'JWT_SEC')
                ]) {
                    sh '''
                    ansible-playbook -i ansible/inventory.ini ansible/playbook.yml \
                    --extra-vars image_tag=${BUILD_NUMBER} \
                    --extra-vars dockerhub_user=${DOCKERHUB_USER} \
                    --extra-vars db_password=${DB_PASS} \
                    --extra-vars jwt_secret=${JWT_SEC} \
                    --extra-vars app_port=${APP_PORT} \
                    --extra-vars db_host=${DB_HOST}
                    '''
                }
            }
        }

        stage('Smoke Test Multi-VM') {
            steps {
                sh '''
                TEST_USER="ci_test_${BUILD_NUMBER}"

                echo "Testing frontend through Host-only IP..."
                curl --connect-timeout 10 --max-time 20 -f ${FRONTEND_URL}

                echo "Testing register on backend..."
                curl --connect-timeout 10 --max-time 20 -f -X POST ${BACKEND_URL}/auth/register \
                  -H "Content-Type: application/json" \
                  -d "{\\"name\\":\\"${TEST_USER}\\",\\"password\\":\\"123456\\"}"

                echo "Testing login on backend..."
                curl --connect-timeout 10 --max-time 20 -f -X POST ${BACKEND_URL}/auth/login \
                  -H "Content-Type: application/json" \
                  -d "{\\"name\\":\\"${TEST_USER}\\",\\"password\\":\\"123456\\"}"
                '''
            }
        }
    }

    post {
        success {
            mail(
                to: 'rubenkiler@gmail.com',
                subject: "SUCCESS: Billing Pipeline #${BUILD_NUMBER}",
                body: """
Pipeline executada com sucesso.

Projeto: ${JOB_NAME}
Build: #${BUILD_NUMBER}

Aplicação:
http://192.168.56.101/login

Backend:
http://192.168.56.101:3000

Jenkins:
http://localhost:8080/job/${JOB_NAME}/${BUILD_NUMBER}/

Status: SUCCESS
"""
            )
        }

        failure {
            mail(
                to: 'rubenkiler@gmail.com',
                subject: "FAILURE: Billing Pipeline #${BUILD_NUMBER}",
                body: """
Pipeline falhou.

Projeto: ${JOB_NAME}
Build: #${BUILD_NUMBER}

Ver logs:
http://localhost:8080/job/${JOB_NAME}/${BUILD_NUMBER}/console

Status: FAILURE
"""
            )
        }

        always {
            sh "docker rmi billing-backend:${BUILD_NUMBER} || true"
            sh "docker rmi billing-frontend:${BUILD_NUMBER} || true"
        }
    }
}